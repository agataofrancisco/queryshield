# Frontend QueryShield (React + Vite servido por nginx). NÃO TESTADO LOCALMENTE (sem Docker).
# Build: docker build -f Dockerfile.frontend --build-arg VITE_API_URL=https://api.exemplo -t queryshield-web .
FROM node:24-alpine AS build
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
ARG VITE_API_URL=
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /web/dist /usr/share/nginx/html
EXPOSE 80
