# Copiar para .env (que NUNCA é commitado) e ajustar. Todos os valores abaixo são de desenvolvimento local.

# Template da ligação por vendedor. Cada role recebe a sua password individual.
QS_READER_DSN_TEMPLATE=postgresql://{role}:{password}@127.0.0.1:5432/queryshield

# Ligação administrativa (superuser local) usada apenas por db/migrate.py e db/seed.py.
QS_ADMIN_DSN=postgresql://postgres@127.0.0.1:5432/queryshield

# Passwords dos roles, definidas por db/migrate.py. Usar três segredos diferentes (24+ caracteres).
QS_READER_PASSWORD_S1=CHANGE_ME_WITH_A_UNIQUE_SECRET_OF_24_CHARS
QS_READER_PASSWORD_S2=CHANGE_ME_WITH_A_DIFFERENT_SECRET_24CH
QS_READER_PASSWORD_S3=CHANGE_ME_WITH_ANOTHER_UNIQUE_SECRET_24CH

# Segredo para assinar JWT demo (HS256). Gerar com: python -c "import secrets;print(secrets.token_urlsafe(48))"
QS_JWT_SECRET=CHANGE_ME_JWT_SECRET

# Gerador: "mock" (determinístico, sem rede) ou "openai" (compatível com a API OpenAI).
QS_LLM_PROVIDER=mock
QS_DEMO_MODE=true
QS_DEMO_AUTH=true
QS_LLM_BASE_URL=https://api.openai.com/v1
QS_LLM_MODEL=TODO_definir_modelo
QS_LLM_API_KEY=

# Origens permitidas para o frontend local (Vite).
QS_CORS_ORIGINS=http://localhost:13200
